import com.sun.net.httpserver.HttpExchange;
import com.sun.net.httpserver.HttpHandler;
import com.sun.net.httpserver.HttpServer;
import java.net.InetSocketAddress;
import java.io.OutputStream;
import java.nio.charset.StandardCharsets;
import java.io.IOException;

/**
 * DeepHat API Server - Versão Estável Zero Dependência
 * Desenvolvido para evitar erro NoClassDefFoundError.
 */
public class ApiServer {
    
    private static int port = 8080;

    public static void main(String[] args) throws Exception {
        // Detecta a porta automaticamente para o Replit/Render
        String portEnv = System.getenv("PORT");
        if (portEnv != null) {
            port = Integer.parseInt(portEnv);
        }

        // Cria o servidor usando a biblioteca nativa do Java
        HttpServer server = HttpServer.create(new InetSocketAddress(port), 0);
        
        // Rota de autenticação
        server.createContext("/v1/auth", new AuthHandler());
        
        // Rota de status
        server.createContext("/v1/status", new StatusHandler());
        
        server.setExecutor(null);
        server.start();
        
        System.out.println("[+] API de Segurança Online!");
        System.out.println("[+] Porta: " + port);
        System.out.println("[+] Status: Aguardando conexão do Bypass...");
    }

    static class AuthHandler implements HttpHandler {
        @Override
        public void handle(HttpExchange exchange) throws IOException {
            // Configura os Headers para evitar erros de conexão (CORS)
            exchange.getResponseHeaders().set("Access-Control-Allow-Origin", "*");
            exchange.getResponseHeaders().set("Access-Control-Allow-Methods", "GET, OPTIONS");
            exchange.getResponseHeaders().set("Access-Control-Allow-Headers", "X-Requested-With, Content-Type, Base64");
            exchange.getResponseHeaders().set("Content-Type", "application/json");

            // Resposta JSON de autorização real
            String response = "{"
                + "\"status\":\"authorized\","
                + "\"token\":\"SECURE_TOKEN_BYPASS_2024\","
                + "\"shield\":\"active\","
                + "\"security_level\":\"max\","
                + "\"bypass_enabled\":true"
                + "}";

            byte[] responseBytes = response.getBytes(StandardCharsets.UTF_8);
            
            // Define o código de resposta 200 (OK)
            exchange.sendResponseHeaders(200, responseBytes.length);
            
            OutputStream os = exchange.getResponseBody();
            os.write(responseBytes);
            os.close();
            
            System.out.println("[*] Requisição de Bypass Recebida e Autorizada.");
        }
    }

    static class StatusHandler implements HttpHandler {
        @Override
        public void handle(HttpExchange exchange) throws IOException {
            exchange.getResponseHeaders().set("Content-Type", "application/json");
            String response = "{\"status\":\"online\", \"system\":\"ready\"}";
            byte[] responseBytes = response.getBytes(StandardCharsets.UTF_8);
            
            exchange.sendResponseHeaders(200, responseBytes.length);
            OutputStream os = exchange.getResponseBody();
            os.write(responseBytes);
            os.close();
        }
    }
}
